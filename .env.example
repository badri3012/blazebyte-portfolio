# BlazeByte Studio Environment Configuration
# ----------------------------------------------------
# IMPORTANT: DO NOT commit real credentials to GitHub.
# Copy this file to .env or configure directly in Vercel/Netlify.

# ==========================================
# PUBLIC VARIABLES (Exposed to Browser)
# ==========================================

# VITE_SITE_URL: The primary production domain used for canonicals.
VITE_SITE_URL=https://blazebytestudio.com

# VITE_ANALYTICS_ID: Public tracking ID (e.g., Google Analytics Measurement ID or Plausible domain).
# If left blank, the analytics system will safely no-op without errors.
VITE_ANALYTICS_ID=

# VITE_FORM_ENDPOINT: The public endpoint to which the contact form posts.
# E.g., a Formspree URL or a public-facing API Gateway.
# If left blank, the form simulates submission and fails gracefully.
VITE_FORM_ENDPOINT=

# ==========================================
# PRIVATE VARIABLES (Server-side Only)
# ==========================================
# NOTE: Because this is a statically generated / CSR Vite app, 
# any secrets (like Resend API Keys, Database URLs) MUST NOT be prefixed with VITE_.
# They should only be used in external Serverless Functions (e.g., api/submit.js).

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx
